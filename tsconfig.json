{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "tests/**/*.ts",
    "supabase/functions/**/logic.ts",
    "scripts/migrate/**/*.ts",
    "scripts/security/**/*.ts",
    "scripts/bonus/**/*.ts"
  ]
}
